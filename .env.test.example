# E2E Test Suite Environment Variables
# Copy this file to backend/.env.test and update with your actual credentials

BACKEND_API_URL=http://localhost:3000

# Fixed Admin Account
E2E_ADMIN_EMAIL=admin@maraekat.com
E2E_ADMIN_PASSWORD=Admin@12345

# Fixed Head Office (HO) Staff Account
E2E_HO_EMAIL=ho@maraekat.com
E2E_HO_PASSWORD=Ho@12345

# 5 Dynamic Accounts (Assigned as Cashiers, Counter Operators, Branch Managers across branches)
E2E_USER_1_EMAIL=user1@maraekat.com
E2E_USER_1_PASSWORD=User@12345

E2E_USER_2_EMAIL=user2@maraekat.com
E2E_USER_2_PASSWORD=User@12345

E2E_USER_3_EMAIL=user3@maraekat.com
E2E_USER_3_PASSWORD=User@12345

E2E_USER_4_EMAIL=user4@maraekat.com
E2E_USER_4_PASSWORD=User@12345

