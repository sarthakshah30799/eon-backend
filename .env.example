# Application
PORT=3000

# Primary Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
# DB_LOGGING=false # Options: true (all queries), error (errors only - default), false (disabled)

# Secondary Database Configuration
DB2_HOST=localhost
DB2_PORT=5432
DB2_USERNAME=your_username
DB2_PASSWORD=your_password
DB2_DATABASE=your_database2

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Database Connection Pool Configuration (Tuned for Free-Tier 15-connection limits)
DB_POOL_MAX=4
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONN_TIMEOUT_MS=10000

DB2_POOL_MAX=4
DB2_POOL_IDLE_TIMEOUT_MS=10000
DB2_POOL_CONN_TIMEOUT_MS=10000

SESSION_POOL_MAX=2
SESSION_POOL_IDLE_TIMEOUT_MS=10000
SESSION_POOL_CONN_TIMEOUT_MS=10000

# GCP Storage Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_PRIVATE_KEY="your_gcp_private_key"
GCP_CLIENT_EMAIL=your_gcp_client_email
GCP_BUCKET_NAME=your_gcp_bucket_name

