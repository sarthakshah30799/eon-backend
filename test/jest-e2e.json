{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "target": "ES2020",
          "esModuleInterop": true,
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "strictNullChecks": false,
          "noImplicitAny": false,
          "types": ["jest", "node"]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "maxWorkers": 1
}

